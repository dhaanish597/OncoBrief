{
  "name": "@oncobrief/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web --port 8081",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src test",
    "test": "node --import tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:web": "expo export --platform web",
    "preview": "node tools/serve-preview.cjs",
    "build:apk": "eas build --platform android --profile preview"
  },
  "dependencies": {
    "@noble/ciphers": "^1.2.1",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.0",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-intent-launcher": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-speech": "^58.0.3",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@react-native/metro-config": "0.88.0",
    "@types/pg": "^8.11.10",
    "@types/react": "~19.3.0",
    "pg": "^8.13.1",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3"
  }
}
