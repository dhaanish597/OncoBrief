{
  "name": "@oncobrief/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "migrate": "tsx src/run-migrate.ts",
    "seed": "tsx src/run-seed.ts",
    "seed:aws": "tsx src/run-seed-aws.ts",
    "demo:reset": "tsx src/run-demo-reset.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@oncobrief/adapters": "workspace:*",
    "@oncobrief/domain": "workspace:*",
    "@oncobrief/ports": "workspace:*",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "vitest": "^2.1.8"
  }
}
