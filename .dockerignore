# Keep the build context small and host-specific artifacts out of the image.
.git
.github
node_modules
**/node_modules
.next
**/.next
test-results
**/test-results
playwright-report
**/playwright-report
.var
infra/build
infra/environments/dev/.terraform
infra/environments/dev/tfplan*
**/.terraform
**/*.tfstate
**/*.tfstate.*
.env
.env.*
!.env.example
*.log
Dockerfile
.dockerignore
