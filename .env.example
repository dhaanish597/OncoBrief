# ---------------------------------------------------------------------------
# OncoBrief environment template. Copy to `.env` and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- database ---------------------------------------------------------------
# The application connects as `oncobrief_app`, which is subject to Row-Level
# Security and has no UPDATE/DELETE grant on the append-only tables.
DATABASE_URL=postgres://oncobrief_app:oncobrief_app@localhost:5432/oncobrief
# Bootstrap + migrator connection. Locally this is the compose superuser, which
# runs 0001_bootstrap and then assumes the DDL-only `oncobrief_migrator` role.
DATABASE_MIGRATOR_URL=postgres://postgres:postgres@localhost:5432/oncobrief

# --- session ---
# 32+ byte random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_SECRET=dev-only-insecure-secret-replace-me-0000000000000000000000

# --- object storage ---------------------------------------------------------
# `fs` = local filesystem adapter (default, zero extra infrastructure).
# `s3` = any S3-compatible store (MinIO locally). See ADR 0013.
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=.var/storage
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=oncobrief-documents
STORAGE_S3_ACCESS_KEY_ID=oncobrief
STORAGE_S3_SECRET_ACCESS_KEY=oncobrief-dev-secret
STORAGE_S3_FORCE_PATH_STYLE=true

# --- ingestion --------------------------------------------------------------
# `auto` | `pdf_text_layer` | `tesseract` | `fixture`
OCR_DRIVER=auto
# Force deterministic fixture extraction (demo fallback). Visible in the UI.
EXTRACTION_DRIVER=rule

# --- app --------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# When true the UI shows demo-fixture badges and the simulated-delivery banner.
ONCOBRIEF_DEMO_MODE=true

NVIDIA_API_KEY=your_key_here
# Chosen from the live NVIDIA API catalog. Any OpenAI-compatible instruct model
# available to your account works — change it without touching code.
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

SARVAM_API_KEY=your_key_here

# ---------------------------------------------------------------------------
# AWS backend (ADR 0015). Leave QUEUE_DRIVER=memory and AUTH_MODE=session for
# the offline local demo. Set the values below for the cloud pipeline.
# ---------------------------------------------------------------------------

# --- authentication ---------------------------------------------------------
# `session` = opaque cookie sessions (default). `cognito` = verify a Cognito
# JWT from the Authorization: Bearer header, then cross-check membership.
AUTH_MODE=session
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Optional explicit issuer; defaults to the pool URL above.
COGNITO_ISSUER=

# --- worker / queues --------------------------------------------------------
# `memory` is for tests only. `sqs` requires the queues below.
QUEUE_DRIVER=memory
WORKER_NAME=oncobrief-ingest
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# LocalStack endpoint, e.g. http://localhost:4566. Blank for real AWS.
AWS_ENDPOINT_URL=
AWS_ACCOUNT_ID=
SQS_DOCUMENT_QUEUE=oncobrief-document-ingest
SQS_OCR_RESULT_QUEUE=oncobrief-ocr-result
SQS_DOCUMENT_QUEUE_URL=
SQS_OCR_RESULT_QUEUE_URL=
WORKER_POLL_WAIT_SECONDS=20
WORKER_VISIBILITY_TIMEOUT_SECONDS=300
OCR_POLL_DELAY_SECONDS=15
OCR_MAX_POLLS=40
MAX_RECEIVE_COUNT=3

# --- S3 (set STORAGE_DRIVER=s3 to enable direct upload) ---------------------
S3_DOCUMENTS_BUCKET=oncobrief-documents
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=ap-south-1
STORAGE_S3_BUCKET=oncobrief-documents
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true

# --- OCR / extraction -------------------------------------------------------
# EXTRACTION_DRIVER is reused above (`rule` | `bedrock`). Bedrock model ids
# differ per region; set one that exists in your AWS_REGION.
BEDROCK_MODEL_ID=
TEXTRACT_NOTIFICATION_TOPIC_ARN=
TEXTRACT_NOTIFICATION_ROLE_ARN=
